# BACKEND_HOST_PORT=8080
# FRONTEND_HOST_PORT=80   (Windows: cổng 80 hay bị chặn — thử FRONTEND_HOST_PORT=3000)
# VITE_API_BASE_URL=http://localhost:8080/api/v1
# CORS_ORIGINS=...       (compose có mặc định gồm localhost + :3000)
